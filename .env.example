# Evolution API — copie para .env na raiz e altere os valores em produção
AUTHENTICATION_API_KEY=altere-esta-chave-em-producao

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:altere-senha@postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379

SERVER_URL=http://localhost:8080
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1030831524

WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true

DATABASE_ENABLED=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CHATS=true
