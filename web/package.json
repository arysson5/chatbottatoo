{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:provision": "node scripts/ensure-database.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/migrate-json-to-postgres.js",
    "test:flow": "node scripts/test-webhook-flow.js",
    "test:unit": "jest --ci",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --ci --coverage",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:ui": "playwright test --config=playwright.config.mjs --ui",
    "test:report": "node scripts/generate-test-report.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:report",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.0",
    "googleapis": "^173.0.0",
    "next": "16.2.4",
    "pdf-parse": "^1.1.1",
    "pdf-to-img": "^4.4.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.2",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6"
  }
}
