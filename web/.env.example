# URL que o Next.js usa para sendText (a mesma que abre a API no navegador).
# Com Nginx na frente (porta 80): http://localhost
# API exposta direto na máquina: http://localhost:8080
EVOLUTION_BASE_URL=http://localhost

# Opcional: URL específica do Manager
# Com API exposta direto na máquina:
# EVOLUTION_MANAGER_URL=http://localhost:8080/manager

# Mesma AUTHENTICATION_API_KEY configurada na Evolution (recomendado para o webhook enviar respostas)
EVOLUTION_GLOBAL_API_KEY=

# URL pública deste app como a Evolution (no Docker) enxerga o host — Windows/macOS Docker Desktop:
WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000

# Opcional: forçar esquema do webhook (ex.: https atrás de proxy)
# FORCE_WEBHOOK_PROTO=https

# Número de teste autorizado a receber respostas do bot (modo dev)
# TEST_TARGET_NUMBER=5511999999999

# Google Gemini — linguagem natural e leitura de comprovante PIX
GEMINI_API_KEY=

# Leitura de comprovante PIX (OCR Tesseract + Sharp) roda no servidor Next.js — sem variável extra.

# Google Calendar OAuth (criar em https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ex.: http://localhost:3000/api/admin/google-calendar/callback
GOOGLE_REDIRECT_URI=
# URL pública do painel no browser (evita redirect para 0.0.0.0 no Docker)
APP_PUBLIC_URL=http://localhost:3000
